{
  "name": "kalid-nur-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch-path=server --watch-path=content server/index.js",
    "start": "node --env-file-if-exists=.env server/index.js",
    "shots": "node scripts/shots.mjs",
    "checks": "node scripts/checks.mjs",
    "checks:prod": "node scripts/checks.mjs --production",
    "new-edition": "node scripts/new-edition.mjs",
    "preview": "node scripts/preview.mjs",
    "og": "node scripts/og.mjs",
    "lighthouse": "node scripts/lighthouse.mjs",
    "work-media": "node scripts/work-media.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "express": "4.19.2",
    "express-rate-limit": "7.4.0",
    "gray-matter": "4.0.3",
    "marked": "12.0.2",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "lighthouse": "13.6.0",
    "playwright": "1.47.2"
  }
}
